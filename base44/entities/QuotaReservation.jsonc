{
  "name": "QuotaReservation",
  "type": "object",
  "x-acl": {
    "create": "admin",
    "read": "user",
    "update": "admin",
    "delete": "admin"
  },
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "period_month": {
      "type": "string",
      "title": "Periode Monat (YYYY-MM)"
    },
    "slot_number": {
      "type": "number",
      "title": "Slot-Nummer (1-based)"
    },
    "research_run_id": {
      "type": "string",
      "title": "ResearchRun ID (Reserviert von)"
    },
    "company_id": {
      "type": "string",
      "title": "Company ID (Nach erfolgreichem Create)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "reserved",
        "committed",
        "released"
      ],
      "default": "reserved"
    },
    "reserved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reserviert am"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Commit am"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "title": "Freigegeben am"
    },
    "description": {
      "type": "string",
      "title": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "organization_id",
    "period_month",
    "slot_number"
  ],
  "unique_constraints": [
    {
      "name": "unique_org_period_slot",
      "fields": [
        "organization_id",
        "period_month",
        "slot_number"
      ],
      "description": "Verhindert doppelte Reservierungen desselben Slots."
    }
  ],
  "indexes": [
    {
      "name": "idx_org_period",
      "fields": [
        "organization_id",
        "period_month"
      ]
    },
    {
      "name": "idx_status",
      "fields": [
        "status"
      ]
    }
  ]
}