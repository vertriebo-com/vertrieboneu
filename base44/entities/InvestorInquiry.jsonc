{
  "name": "InvestorInquiry",
  "type": "object",
  "x-acl": {
    "create": "public",
    "read": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "E-Mail"
    },
    "company_name": {
      "type": "string",
      "title": "Unternehmen / Fonds"
    },
    "role": {
      "type": "string",
      "title": "Rolle",
      "enum": [
        "Investor",
        "Business Angel",
        "Strategischer Partner",
        "Presse",
        "Sonstiges"
      ],
      "default": "Investor"
    },
    "message": {
      "type": "string",
      "title": "Nachricht"
    },
    "consent_accepted": {
      "type": "boolean",
      "title": "Einwilligung akzeptiert",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "geprueft",
        "contacted",
        "gespraech",
        "abgelehnt"
      ],
      "default": "new"
    },
    "source_page": {
      "type": "string",
      "title": "Quellseite"
    },
    "internal_note": {
      "type": "string",
      "title": "Interne Notiz"
    },
    "contacted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Kontaktiert am"
    },
    "meeting_date": {
      "type": "string",
      "format": "date-time",
      "title": "Meeting-Termin"
    },
    "handled_by": {
      "type": "string",
      "title": "Bearbeitet von (E-Mail)"
    }
  },
  "required": [
    "name",
    "email",
    "consent_accepted"
  ]
}