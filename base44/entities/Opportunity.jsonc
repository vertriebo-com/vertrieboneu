{
  "name": "Opportunity",
  "type": "object",
  "x-acl": {
    "create": "user",
    "read": "user",
    "update": "user",
    "delete": "admin"
  },
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organisation ID",
      "description": "Pflicht. Mandanten-Isolation."
    },
    "company_id": {
      "type": "string",
      "title": "Firma ID",
      "description": "Pflicht. Zugeh\u00f6rige Company."
    },
    "primary_contact_id": {
      "type": "string",
      "title": "Prim\u00e4rer Ansprechpartner ID"
    },
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "stage": {
      "type": "string",
      "title": "Pipeline Stage",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "offer_planned",
        "offer_sent",
        "negotiation",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "open",
        "won",
        "lost",
        "archived"
      ],
      "default": "open"
    },
    "value": {
      "type": "number",
      "title": "Auftragswert (EUR)"
    },
    "probability": {
      "type": "number",
      "title": "Abschluss-Wahrscheinlichkeit (%)"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date-time",
      "title": "Geplanter Abschluss"
    },
    "source_type": {
      "type": "string",
      "title": "Herkunft",
      "enum": [
        "manual",
        "research",
        "email",
        "import",
        "unknown"
      ],
      "default": "manual"
    },
    "source_research_run_id": {
      "type": "string",
      "title": "Recherche-Lauf ID"
    },
    "won_lost_reason": {
      "type": "string",
      "title": "Grund (Won/Lost)"
    },
    "notes": {
      "type": "string",
      "title": "Notizen"
    },
    "assigned_to": {
      "type": "string",
      "title": "Zugewiesen an (E-Mail)"
    },
    "created_by": {
      "type": "string",
      "title": "Erstellt von (E-Mail)"
    },
    "stage_changed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Stage ge\u00e4ndert am"
    },
    "stage_changed_by": {
      "type": "string",
      "title": "Stage ge\u00e4ndert von (E-Mail)"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Abgeschlossen am"
    },
    "won_at": {
      "type": "string",
      "format": "date-time",
      "title": "Gewonnen am"
    },
    "lost_at": {
      "type": "string",
      "format": "date-time",
      "title": "Verloren am"
    }
  },
  "required": [
    "organization_id",
    "company_id",
    "title"
  ]
}