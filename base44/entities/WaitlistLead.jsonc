{
  "name": "WaitlistLead",
  "type": "object",
  "x-acl": {
    "create": "public",
    "read": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "E-Mail"
    },
    "company_name": {
      "type": "string",
      "title": "Firma"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "industry": {
      "type": "string",
      "title": "Branche"
    },
    "company_size": {
      "type": "string",
      "title": "Unternehmensgr\u00f6\u00dfe"
    },
    "message": {
      "type": "string",
      "title": "Nachricht"
    },
    "source_page": {
      "type": "string",
      "title": "Quellseite"
    },
    "utm_source": {
      "type": "string",
      "title": "UTM Source"
    },
    "utm_campaign": {
      "type": "string",
      "title": "UTM Campaign"
    },
    "consent_accepted": {
      "type": "boolean",
      "title": "Einwilligung akzeptiert",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "demo_geplant",
        "onboarded",
        "abgelehnt"
      ],
      "default": "new"
    },
    "internal_note": {
      "type": "string",
      "title": "Interne Notiz"
    },
    "contacted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Kontaktiert am"
    },
    "demo_date": {
      "type": "string",
      "format": "date-time",
      "title": "Demo-Termin"
    },
    "handled_by": {
      "type": "string",
      "title": "Bearbeitet von (E-Mail)"
    },
    "converted_organization_id": {
      "type": "string",
      "title": "Umgewandelt zu Org-ID"
    }
  },
  "required": [
    "email"
  ]
}