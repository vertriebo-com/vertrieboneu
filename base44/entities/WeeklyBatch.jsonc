{
  "name": "WeeklyBatch",
  "type": "object",
  "x-acl": {
    "create": "user",
    "read": "user",
    "update": "user",
    "delete": "admin"
  },
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "kalenderwoche": {
      "type": "number",
      "title": "Kalenderwoche"
    },
    "jahr": {
      "type": "number",
      "title": "Jahr"
    },
    "anzahl_firmen": {
      "type": "number",
      "title": "Anzahl Firmen"
    },
    "assigned_to": {
      "type": "string",
      "title": "Zugewiesen an"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Offen",
        "In Bearbeitung",
        "Abgeschlossen"
      ],
      "default": "Offen"
    },
    "description": {
      "type": "string",
      "title": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "kalenderwoche",
    "jahr"
  ]
}