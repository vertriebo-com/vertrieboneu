{
  "name": "SupportNote",
  "type": "object",
  "x-acl": {
    "create": "user",
    "read": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organisations ID"
    },
    "created_by": {
      "type": "string",
      "title": "Erstellt von (E-Mail)"
    },
    "note": {
      "type": "string",
      "title": "Notiz"
    },
    "severity": {
      "type": "string",
      "title": "Schweregrad",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "open",
        "reviewed",
        "resolved"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "title": "Priorit\u00e4t",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "internal_reply_note": {
      "type": "string",
      "title": "Interne Antwortnotiz"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Gepr\u00fcft von (E-Mail)"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Gepr\u00fcft am"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Erledigt am"
    }
  },
  "required": [
    "organization_id",
    "created_by",
    "note"
  ]
}