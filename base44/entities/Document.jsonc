{
  "name": "Document",
  "type": "object",
  "x-acl": {
    "create": "user",
    "read": "user",
    "update": "user",
    "delete": "admin"
  },
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "company_id": {
      "type": "string",
      "title": "Firma ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Kontakt ID"
    },
    "opportunity_id": {
      "type": "string",
      "title": "Opportunity ID"
    },
    "titel": {
      "type": "string",
      "title": "Titel"
    },
    "beschreibung": {
      "type": "string",
      "title": "Beschreibung"
    },
    "file_url": {
      "type": "string",
      "title": "Datei URL"
    },
    "dateiname": {
      "type": "string",
      "title": "Dateiname"
    },
    "kategorie": {
      "type": "string",
      "title": "Kategorie",
      "enum": [
        "Preisliste",
        "Pr\u00e4sentation",
        "Vertrag",
        "Angebot",
        "Sonstiges"
      ],
      "default": "Sonstiges"
    },
    "document_type": {
      "type": "string",
      "title": "Dokumenttyp",
      "enum": [
        "note",
        "offer",
        "contract",
        "email_attachment",
        "other"
      ],
      "default": "other"
    },
    "source_type": {
      "type": "string",
      "title": "Herkunft",
      "enum": [
        "manual",
        "generated",
        "import",
        "email",
        "unknown"
      ],
      "default": "manual"
    }
  },
  "required": [
    "titel",
    "file_url"
  ]
}