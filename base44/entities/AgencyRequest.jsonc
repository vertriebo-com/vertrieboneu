{
  "name": "AgencyRequest",
  "type": "object",
  "x-acl": {
    "create": "public",
    "read": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "user_id": {
      "type": "string",
      "title": "Benutzer ID"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "enum": [
        "agency"
      ],
      "default": "agency"
    },
    "source": {
      "type": "string",
      "title": "Quelle",
      "enum": [
        "pricing_page",
        "public_pricing_page"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "company_name": {
      "type": "string",
      "title": "Agentur / Unternehmen"
    },
    "email": {
      "type": "string",
      "title": "E-Mail"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "estimated_client_organizations": {
      "type": "number",
      "title": "Gesch\u00e4tzte Kundenorganisationen"
    },
    "message": {
      "type": "string",
      "title": "Nachricht"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Eingereicht am"
    },
    "ip_source": {
      "type": "string",
      "title": "IP-Quelle"
    }
  },
  "required": [
    "plan",
    "source",
    "name",
    "email",
    "phone"
  ]
}